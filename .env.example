# Variables the API (apps/api) reads; see apps/api/scripts/dev.sh and ops/DEPLOY.md.
# Paths point at files holding secrets (mode 600); never put secret values here.
SIWS_DOMAIN=
SIWS_ALLOWED_CHAINS=solana:devnet
JWT_SECRET_PATH=
JWT_ISSUER=bountycam-api
JWT_AUDIENCE=bountycam-app
SOLANA_CLUSTER=devnet
SETTLEMENT_MINT=
DATABASE_URL=postgres://user:password@127.0.0.1:5432/bountycam
SOLANA_RPC_URL=https://api.devnet.solana.com
SEEKER_RPC_URL=
ESCROW_PROGRAM_ID=
ESCROW_CONFIG_ACCOUNT=
ELIGIBILITY_KEY_PATH=
EVIDENCE_STORE_ENDPOINT=http://127.0.0.1:7070
EVIDENCE_STORE_BUCKET=bountycam-evidence
EVIDENCE_STORE_ACCESS_KEY_ID=
EVIDENCE_STORE_SECRET_PATH=
# Verifier only
ATTESTER_KEY_PATH=
# Verifier, and the API's devnet faucet (D167)
RELAYER_KEY_PATH=
# Devnet faucet (D167): off when empty. The key must be the test mint's authority.
FAUCET_KEY_PATH=
# Optional: FAUCET_USDC_BASE_UNITS (20000000), FAUCET_LAMPORTS (20000000),
# FAUCET_COOLDOWN_S (86400), FAUCET_DAILY_CAP (200), FAUCET_CONFIRM_S (30)
# settle.mjs only (laptop); never deployed
ARBITER_KEY_PATH=
